plan.json

# Local secret var files (prod.tfvars is committed; secrets are ignored)
secrets.tfvars
*.secret.tfvars
*.local.tfvars
terraform.tfvars

# Override files & logs
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log
.terraformrc
terraform.rc

