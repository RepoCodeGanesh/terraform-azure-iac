###############################################################################
# Terraform
###############################################################################

# Terraform working directory
**/.terraform/

# Terraform state
*.tfstate
*.tfstate.*

# Terraform plans
*.tfplan
*.tfplan.*
tfplan
tfplan.binary
plan.json


# Terraform variable files
*.auto.tfvars
*.auto.tfvars.json

# Ignore local tfvars but allow examples
terraform.tfvars
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs
crash.log
crash.*.log

# CLI configuration
.terraformrc
terraform.rc

